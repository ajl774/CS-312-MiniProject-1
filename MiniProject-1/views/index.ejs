<!DOCTYPE html>

<!-- root element -->
<html lang = "en">

    <!-- head element -->
    <head >
        <!-- webpage title -->
        <title>
            Blogville
        </title>

        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- linking bootstrap document -->
         
        <link rel="stylesheet"  href="styles.css" >
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        
    </head>

    <!-- body section -->
    
    <div class="container-fluid full-width-bg bg-dark bg-gradient p-5 text-white ">
        <div class = "container " id = "header">
            <div class = "row font-effect-3d-float ">
                <h1 >Unique Blog Website!</h1>
            </div>
            <hr>
        </div>
    </div>
    <body class="d-flex flex-column min-vh-100 justify-content-center">
        <nav class="navbar navbar-expand-lg bg-body-tertiary" id = "navBar">
            <div class="mx-auto">     
                    <button id = "createPostBtn" class="btn btn-dark"> Create new blog:</button>
                    <form action ="/submit" onsubmit="this.submit();this.reset();return false;" method="POST" id="blogForm">
                        <h3>Create new post!</h3>
                        <div class = "form-group">
                            <label for="authName">Authors name:</label><br>
                            <input type="text" name="authName" id="authName" required>
                        </div>
                        <div class = "form-group">
                            <label for="title">Blog title:</label><br>
                            <input type="text" name="title" id="title" required>
                        </div>
                        <div class = "form-group">
                            <label for="BlogText">Blog text:</label><br>
                            <textarea
                                id="BlogText" 
                                name="blogText" 
                                rows="5" 
                                cols="40" 
                                placeholder="Type your message here..."></textarea><br>  
                        </div>
                        <div class = "form-group">
                            <button id="closeFormBtn" class="btn btn-secondary" type = "button" value="cancel" formnovalidate>Exit</button>
                            <button id ="submitBtn" class="btn btn-primary" type="submit" >Submit</button>
                        </div>
                    </form>
                </div> 
            </div>
        </nav>
        <br>
        <div class = "container">  
            <%if (locals.blogPosts && postNumber) { %>
                <h2> Blog posts:</h2>
                <% for (let i = 0; i < postNumber; i++) {%>
                    <%let list = blogPosts[i]; %>
                    <div class="d-flex flex-row text-left" id ='postDiv'>
                        <div class = "d-flex flex-column">
                            <h2>Blog title: <%= list[0] %></h2>
                            <h3>Blog Author: <%= list[1] %></h3>
                            <h4>Date created: <%= list[2] %></h4>
                            <% if (list[3]) {%>
                                <h5 id = 'blogText'><%= list[3] %></h5>
                            <% } %>
                        </div>
                        <div class = "ms-auto">
                            <form action="/delete" method="POST" style="display:inline;">
                                <input type="hidden" name="deleteId" value="<%= i %>">
                                <button type="submit" class="btn btn-danger" >Delete</button>
                            </form>
                            <form action="/edit" method="POST" style="display:inline;">
                                <input type="hidden" name="editId" value="<%= i %>">
                                <button id="editBtn" class="btn btn-primary" type="submit">Edit</button>
                            </form>
                        </div>
                    </div>
            <% } %>
            <br>
            <% } else {%>
                    <div >
                        <h2 id = "noBlogs">Opps! There are no blogs. Create some more! Create, edit, or delete posts now!</h2>
                    </div>
            <%} %>   
        </div>

        <div class="mt-auto bg-dark bg-gradient p-5 text-white ">
            <div class = "container-fluid" id = "footer">
                <div class = "row font-effect-3d-float ">
                    <h2 ></h2>
                </div>
                <hr>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="/app.js"></script>
    </body>   
    
</html>