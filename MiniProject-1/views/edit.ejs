<!DOCTYPE html>

<!-- root element -->
<html lang = "en">

    <!-- head element -->
    <head >
        <!-- webpage title -->
        <title>
            Blogville
        </title>

        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- linking bootstrap document -->
         
        <link rel="stylesheet"  href="styles.css" >
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        
    </head>

    <!-- body section -->
    
    <div class="container-fluid full-width-bg bg-dark bg-gradient p-5 text-white ">
        <div class = "container " id = "header">
            <div class = "row font-effect-3d-float ">
                <h1 >Unique Blog Website!</h1>
            </div>
            <hr>
        </div>
    </div>

    <body class="d-flex flex-column min-vh-100 justify-content-center">
        <nav class="navbar navbar-expand-lg bg-body-tertiary" id = "navBar">
            <div class="mx-auto">

                <form action ="/save" onsubmit="this.submit();this.reset();return false;" method="POST" >
                    <h3>Edit post:</h3>
                    <div class = "form-group">
                        <label for="authName">Authors name:</label><br>
                        <input type="text" name="authName" id="authName" value ="<%= item[0] %>" required> 
                    </div>
                    <div class = "form-group">
                        <label for="title">Blog title:</label><br>
                        <input type="text" name="title" id="title" value ="<%= item[1] %>" required>
                    </div>
                    <div class = "form-group">
                        <label for="BlogText">Blog text:</label><br>
                        
                        <textarea
                            id="BlogText" 
                            name="blogText" 
                            rows="5" 
                            
                            placeholder="Type your message here..."><%= item[3] %></textarea><br> 
                    </div>
                    <div class = "form-group">
                        <button id="exitEdBtn" class="btn btn-secondary" >Exit</button>
                        <button id ="saveBtn" class="btn btn-primary" type="submit" >Save changes</button>
                    </div>
                </form>
            </div>

        </nav>


        
        <div class="mt-auto bg-dark bg-gradient p-5 text-white ">
            <div class = "container-fluid" id = "footer">
                <div class = "row font-effect-3d-float ">
                    <h2 ></h2>
                </div>
                <hr>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="app.js"></script>
        </body>   
</html>

    